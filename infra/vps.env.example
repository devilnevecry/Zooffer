# Public VPS environment (web + Caddy).
# Copy to infra/.env on the VPS and replace every <PLACEHOLDER>.

# Domain served by Caddy (DNS A record -> VPS public IP).
ZOOFER_DOMAIN=<DOMAIN>
ZOOFER_EMAIL=<ADMIN_EMAIL_FOR_ACME>

# Where Caddy forwards /api/* and /media/*. This must be reachable from the VPS,
# e.g. the PC's Tailscale IP or a Cloudflare Tunnel hostname WITH scheme.
ZOOFER_BACKEND_UPSTREAM=http://<PC_TUNNEL_HOST>:8000

# Where Caddy forwards /telegram/* (only needed for BOT_MODE=webhook).
ZOOFER_BOT_UPSTREAM=http://<PC_TUNNEL_HOST>:8081

# Telegram public values. These are baked into the Next.js bundle at build time.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=<BOT_USERNAME_WITHOUT_@>
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/<BOT_USERNAME_WITHOUT_@>
NEXT_PUBLIC_TELEGRAM_MINI_APP_URL=https://<DOMAIN>/tg
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/<CHANNEL>
