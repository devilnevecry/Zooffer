# Values for the public-facing VPS container (web + Caddy).
# Copy to /etc/zooffer/zooffer.env and keep permissions 0600.

ZOOFER_EMAIL=no-reply@zooffer.ru
ZOOFER_DOMAIN=zooffer.ru
ZOOFER_BACKEND_UPSTREAM=http://<PC_TUNNEL_IP>:8000
ZOOFER_BACKEND_UPSTREAM_BOT=http://<PC_TUNNEL_IP>:8081
ZOOFER_WEB_UPSTREAM=http://127.0.0.1:3000

# Baked into the Next.js build on the VPS.
NEXT_PUBLIC_APP_URL=https://zooffer.ru
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=<SET_BY_BOTFATHER>
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/<SET_BY_BOTFATHER>
NEXT_PUBLIC_TELEGRAM_MINI_APP_URL=https://zooffer.ru/tg
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/<CHANNEL>
API_INTERNAL_URL=http://<PC_TUNNEL_IP>:8000

SESSION_SECRET=<SECRET>
SECRET_PEPPER=<PEPPER>
METRICS_TOKEN=<TOKEN>
PAYMENT_PROVIDER=telegram_stars
TELEGRAM_STARS_ENABLED=true
