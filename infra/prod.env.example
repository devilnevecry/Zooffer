# Production backend configuration for the self-hosted topology (PC + VPS).
# Copy to .env and fill real values. Never commit real secrets.

ENVIRONMENT=prod
LOG_LEVEL=INFO

APP_BASE_URL=https://zooffer.ru
API_BASE_URL=https://zooffer.ru
PUBLIC_API_URL=https://zooffer.ru

POSTGRES_USER=zooffer
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=zooffer
REDIS_PASSWORD=<REDIS_PASSWORD>

SESSION_SECRET=<GENERATE_32_CHARS>
SECRET_PEPPER=<GENERATE_32_CHARS>
COOKIE_SECURE=true
COOKIE_DOMAIN=

METRICS_TOKEN=<GENERATE_32_CHARS>

TELEGRAM_BOT_TOKEN=<SET_BY_BOTFATHER>
TELEGRAM_BOT_USERNAME=<SET_BY_BOTFATHER>
TELEGRAM_WEBHOOK_SECRET=<GENERATE>
TELEGRAM_ADMIN_CHAT_ID=<ADMIN_TELEGRAM_ID>
TELEGRAM_CHANNEL_URL=https://t.me/<CHANNEL>

PAYMENT_PROVIDER=telegram_stars
TELEGRAM_STARS_ENABLED=true

ENABLE_TELEGRAM=true
ENABLE_GLASS=true
FREE_DAILY_SWIPES=20
QUOTA_TIMEZONE=Europe/Moscow

MEDIA_BACKEND=local
MEDIA_LOCAL_PATH=/data/media
MEDIA_PUBLIC_BASE_URL=https://zooffer.ru

EMAIL_AUTH_ENABLED=false
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@zooffer.ru
