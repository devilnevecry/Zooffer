# Backend + bot + database environment for the PC host.
# Copy to infra/.env (the compose file reads it automatically) and replace every
# <PLACEHOLDER>. Never commit the filled file.

ENVIRONMENT=prod
LOG_LEVEL=INFO

# Public site URL (Caddy on the VPS).
APP_BASE_URL=https://<DOMAIN>
API_BASE_URL=https://<DOMAIN>
PUBLIC_API_URL=https://<DOMAIN>
MEDIA_PUBLIC_BASE_URL=https://<DOMAIN>

# Database / Redis (internal to the compose network).
POSTGRES_USER=zooffer
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD>
POSTGRES_DB=zooffer
REDIS_PASSWORD=<GENERATE_STRONG_PASSWORD>

# Secrets: at least 32 random characters each. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=<GENERATE_32_CHARS>
SECRET_PEPPER=<GENERATE_32_CHARS>
METRICS_TOKEN=<GENERATE_32_CHARS>

# Telegram (BotFather).
TELEGRAM_BOT_TOKEN=<BOT_TOKEN_FROM_BOTFATHER>
TELEGRAM_BOT_USERNAME=<BOT_USERNAME_WITHOUT_@>
TELEGRAM_WEBHOOK_SECRET=<GENERATE_32_CHARS>
TELEGRAM_ADMIN_CHAT_ID=<YOUR_TELEGRAM_ID>
TELEGRAM_CHANNEL_URL=https://t.me/<CHANNEL>
# Only needed for the one-time admin promotion; leave empty afterwards.
ADMIN_BOOTSTRAP_TOKEN=

# Payments: Telegram Stars is the launch path.
PAYMENT_PROVIDER=telegram_stars
TELEGRAM_STARS_ENABLED=true
# Additional path: crypto wallet transfers confirmed manually by an admin.
CRYPTO_PAYMENT_ENABLED=true
CRYPTO_PAYMENT_WALLET_ADDRESS=<WALLET_ADDRESS>
CRYPTO_PAYMENT_ASSET=USDT
CRYPTO_PAYMENT_NETWORK=TON

# Website (served by the web container on port 3000 on the PC host).
WEB_APP_URL=http://localhost:3000
TELEGRAM_BOT_URL=https://t.me/<BOT_USERNAME>

# Bot transport. polling works behind NAT/CGNAT. Set to webhook only after a
# tunnel exposes https://<DOMAIN>/telegram/webhook to this host.
BOT_MODE=polling
TELEGRAM_WEBHOOK_URL=

# Product limits.
ENABLE_TELEGRAM=true
ENABLE_GLASS=true
FREE_DAILY_SWIPES=20
QUOTA_TIMEZONE=Europe/Moscow

# Telegram-only launch. Email/password endpoints stay disabled in production.
EMAIL_AUTH_ENABLED=false
MEDIA_BACKEND=local
MEDIA_LOCAL_PATH=/data/media

# Optional website card provider (leave telegram_stars above unless used).
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=true
