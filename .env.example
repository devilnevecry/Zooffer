# Copy to .env and fill values locally. Never commit .env.
# Values marked CHANGE_ME are rejected at startup in production.

ENVIRONMENT=dev
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000

# --- Database / cache -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://zooffer:zooffer_dev_password@localhost:5432/zooffer
TEST_DATABASE_URL=postgresql+asyncpg://zooffer:zooffer_dev_password@localhost:5432/zooffer_test
REDIS_URL=redis://localhost:6379/0

# --- Security ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_DEV_SESSION_SECRET
SECRET_PEPPER=CHANGE_ME_DEV_SECRET_PEPPER
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LOGIN_BOT_ID=
TELEGRAM_LOGIN_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_URL=

# --- Telegram bot runtime ---------------------------------------------------
# Use BOT_MODE=polling for local development; webhook requires a public HTTPS URL.
BOT_MODE=polling
BOT_PUBLIC_URL=http://localhost:3000
BOT_WEBHOOK_PATH=/telegram/webhook
BOT_WEBHOOK_HOST=0.0.0.0
BOT_WEBHOOK_PORT=8081
BOT_UPDATE_QUEUE=inline
BOT_UPDATE_WORKERS=1
BOT_FSM_TTL_SECONDS=3600
BOT_THROTTLE_LIMIT=25
BOT_THROTTLE_WINDOW=10
BOT_GLOBAL_THROTTLE_LIMIT=200
BOT_GLOBAL_THROTTLE_WINDOW=10
BOT_NOTIFICATION_WORKER=true
BOT_NOTIFICATION_INTERVAL=15
BOT_NOTIFICATION_BATCH=20
BOT_NOTIFICATION_MAX_AGE_HOURS=24

# --- Payments ---------------------------------------------------------------
# fake            works only when ENVIRONMENT is dev or test (clearly labelled demo)
# telegram_stars  subscriptions paid with Telegram Stars inside the bot / Mini App
# robokassa       website card payments (signed ResultURL notification)
# yookassa        website card payments (unsigned notification, re-fetched by API)
# Telegram never offers an external card link for digital goods.
PAYMENT_PROVIDER=fake
TELEGRAM_STARS_ENABLED=false

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/account/subscription

# Robokassa: Password1 signs the payment form, Password2 signs ResultURL.
# Keep ROBOKASSA_IS_TEST=true until a real test payment succeeds.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=true
ROBOKASSA_HASH_ALGO=md5

# --- Media ------------------------------------------------------------------
# Only local disk is implemented. S3-compatible storage is blocked (B9).
MEDIA_BACKEND=local
MEDIA_LOCAL_PATH=./data/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8000

# --- Email ------------------------------------------------------------------
# The launch is Telegram-only: email/password auth stays disabled in production.
# EMAIL_AUTH_ENABLED=true is a development escape hatch for the legacy test suite.
EMAIL_AUTH_ENABLED=false
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.invalid

# --- Product settings (admin-editable at runtime; env is the default) -------
FREE_DAILY_SWIPES=20
QUOTA_TIMEZONE=Europe/Moscow
ENABLE_TELEGRAM=false
ENABLE_GLASS=true
# One-shot token for scripts/bootstrap_admin.py; rotate or clear after use.
ADMIN_BOOTSTRAP_TOKEN=

# --- Web build-time variables (baked by `npm run build`) --------------------
# NEXT_PUBLIC_APP_URL=https://zooffer.ru
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=zooffer_bot
# NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/zooffer_bot
# NEXT_PUBLIC_TELEGRAM_MINI_APP_URL=https://zooffer.ru/tg
# NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/zooffer_news
# API_INTERNAL_URL=http://127.0.0.1:8000
# TELEGRAM_WEBHOOK_URL=https://zooffer.ru/telegram/webhook

# --- Observability ----------------------------------------------------------
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN
SENTRY_DSN=
