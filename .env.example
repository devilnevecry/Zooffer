# Copy to .env and fill values locally. Never commit .env.
# Values marked CHANGE_ME are rejected at startup in production.

ENVIRONMENT=dev
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000

# --- Database / cache -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://zooffer:zooffer_dev_password@localhost:5432/zooffer
TEST_DATABASE_URL=postgresql+asyncpg://zooffer:zooffer_dev_password@localhost:5432/zooffer_test
REDIS_URL=redis://localhost:6379/0

# --- Security ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_DEV_SESSION_SECRET
SECRET_PEPPER=CHANGE_ME_DEV_SECRET_PEPPER
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LOGIN_BOT_ID=
TELEGRAM_LOGIN_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_URL=

# --- Telegram bot runtime ---------------------------------------------------
# Use BOT_MODE=polling for local development; webhook requires a public HTTPS URL.
BOT_MODE=polling
BOT_PUBLIC_URL=http://localhost:3000
BOT_WEBHOOK_PATH=/telegram/webhook
BOT_WEBHOOK_HOST=0.0.0.0
BOT_WEBHOOK_PORT=8081
BOT_UPDATE_QUEUE=inline
BOT_UPDATE_WORKERS=1
BOT_FSM_TTL_SECONDS=3600
BOT_THROTTLE_LIMIT=25
BOT_THROTTLE_WINDOW=10
BOT_GLOBAL_THROTTLE_LIMIT=200
BOT_GLOBAL_THROTTLE_WINDOW=10
BOT_NOTIFICATION_WORKER=true
BOT_NOTIFICATION_INTERVAL=15
BOT_NOTIFICATION_BATCH=20
BOT_NOTIFICATION_MAX_AGE_HOURS=24

# --- Payments ---------------------------------------------------------------
# fake works only when ENVIRONMENT is dev or test and is clearly labelled as a demo.
# yookassa requires merchant credentials; its webhook is unsigned, so the backend
# re-fetches the payment before changing state.
PAYMENT_PROVIDER=fake
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/account/subscription

# --- Media ------------------------------------------------------------------
MEDIA_BACKEND=local
MEDIA_LOCAL_PATH=./data/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8000
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Email ------------------------------------------------------------------
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.invalid

# --- Product settings (admin-editable at runtime; env is the default) -------
FREE_DAILY_SWIPES=20
QUOTA_TIMEZONE=Europe/Moscow
ENABLE_TELEGRAM=false
ENABLE_GLASS=true

# --- Observability ----------------------------------------------------------
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN
SENTRY_DSN=
